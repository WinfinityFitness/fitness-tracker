<?xml version="1.0" encoding="utf-8"?>
<!-- Same fix as capacitor-app's native-res/drawable/splash_bg.xml (see that
     file's own comment): a solid background with the logo shown at its own
     clean size, centered, not stretched to fill the screen, which is what
     Capacitor's default-generated full-bleed splash.png does and why it
     looks blurry/pixelated. splash_logo.png is density-bucketed under
     drawable-*dpi so Android picks the right resolution automatically. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splashBackground"/>
    <item android:drawable="@drawable/splash_logo" android:gravity="center"/>
</layer-list>
